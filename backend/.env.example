# Local development can run without Supabase. Production deliberately cannot.
JWT_SECRET=replace_with_a_long_random_value
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
SUPABASE_STORAGE_BUCKET=proposal-files
APP_URL=http://localhost:5173
CRON_SECRET=replace_with_a_second_long_random_value

# AI is OFF unless explicitly enabled. OpenAI API usage is billable.
AI_ENABLED=false
AI_WEB_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
